# Treat generated 3D and bake outputs as binary in Git diffs.
*.glb -diff
*.ktx2 -diff
*.exr -diff
*.blend -diff
# Git LFS remains an explicit decision for large art sources and bakes.

# Editable Blender source and baked archives use Git LFS when committed.
art/**/*.blend filter=lfs diff=lfs merge=lfs -text
art/bake/**/*.exr filter=lfs diff=lfs merge=lfs -text
